{:paths ["src"]
 :deps {net.jmglov/blambda
        {:git/url "https://github.com/jmglov/blambda.git"
         :git/tag "v0.2.0"
         :git/sha "fa394bb"}}
 :tasks
 {:requires ([blambda.cli :as blambda]
             [babashka.process :as p]
             [babashka.fs :as fs]
             [clojure.java.io :as io]
             [clojure.string :as str])

  :init
  (do
    ;; --- documentation site -------------------------------------------------
    ;; The generator lives in jlt-commons/docs-engine, not here. The site is
    ;; built in CI (.github/workflows/site.yml, which pins an engine tag), so
    ;; these tasks exist only for local preview and are the one place that
    ;; needs a checkout of the engine on disk.
    (def repo-root (str (fs/parent (fs/absolutize "bb.edn"))))

    (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")

    (defn docs-engine-dir
      "Where the engine is checked out: $DOCS_ENGINE, else a sibling
       directory, else the usual spot. nil when none of them exist."
      []
      (let [home (System/getProperty "user.home")]
        (->> [(System/getenv "DOCS_ENGINE")
              "../docs-engine"
              (str home "/dev/jlt-commons/docs-engine")]
             (remove nil?)
             (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
             first)))

    (defn site-task
      "Runs one of the engine's tasks against this project."
      [task & args]
      (if-let [engine (docs-engine-dir)]
        (let [argv (into ["bb" task repo-root] (remove nil? args))
              res  (apply p/shell {:dir (str engine) :continue true} argv)]
          (when-not (zero? (:exit res)) (System/exit (:exit res))))
        (do
          (println "The docs engine is not checked out anywhere I looked:")
          (println "  $DOCS_ENGINE, ../docs-engine, ~/dev/jlt-commons/docs-engine")
          (println)
          (println "  git clone" docs-engine-repo "../docs-engine")
          (println)
          (println "CI does not need this. It checks the engine out itself.")
          (System/exit 1)))))

  blambda {:doc "Controls Blambda runtime and layers"
           :task (blambda/dispatch
                  {:lambda-name "lambda-mvp-bb"
                   :source-files ["net/b12n/lambda_mvp/handler.clj"]
                   :bb-arch (or (System/getenv "LAMBDA_ARCH") "arm64")
                   :runtime-layer-name "lambda-mvp-bb-runtime"})}

  build {:doc "bb blambda build-runtime-layer + build-lambda -> two zips in target/"
         :task (do (p/shell "bb" "blambda" "build-runtime-layer")
                   (p/shell "bb" "blambda" "build-lambda"))}

  clean {:doc "remove build artifacts"
         :task (p/shell "rm" "-rf" "target" ".work")}

  probe {:doc "offline e2e: mock Runtime API + blambda's real bootstrap.clj loop (no AWS, no Docker)"
         :task (let [port-file ".mock-runtime-api-port"]
                 (fs/delete-if-exists port-file)
                 (let [mock (p/process ["python3" "tools/mock_runtime_api.py"] {:inherit true})]
                   (try
                     (loop [n 0]
                       (when (and (not (fs/exists? port-file)) (< n 50))
                         (Thread/sleep 100)
                         (recur (inc n))))
                     (if-not (fs/exists? port-file)
                       (do (println "probe: mock server did not publish its port -- aborting")
                           (System/exit 1))
                       (let [port (str/trim (slurp port-file))
                             bootstrap-clj (str (fs/file (io/resource "bootstrap.clj")))
                             bb-proc (p/process ["bb" bootstrap-clj]
                                                {:inherit true
                                                 :extra-env {"AWS_LAMBDA_RUNTIME_API" (str "127.0.0.1:" port)
                                                             "_HANDLER" "net.b12n.lambda-mvp.handler/handler"}})
                             mock-result (deref mock)]
                         ;; blambda's bootstrap.clj has no non-200 check on /invocation/next
                         ;; (unlike jlt/jnk/rst's hand-rolled loops), so once the mock's canned
                         ;; events run out and it answers 410 to signal done, bootstrap.clj
                         ;; crashes with an uncaught exception instead of exiting cleanly --
                         ;; verified live, see the design spec. Success is judged from the
                         ;; MOCK's own exit code, never bootstrap.clj's.
                         (when (p/alive? bb-proc)
                           (p/destroy-tree bb-proc))
                         (System/exit (:exit mock-result))))
                     ;; Safety net only -- normal completion always ends via System/exit
                     ;; above, which halts the JVM before this finally would run. This
                     ;; guards the case where something throws between starting the mock
                     ;; and (deref mock), which would otherwise leave the mock process
                     ;; orphaned and holding its port.
                     (finally
                       (when (p/alive? mock)
                         (p/destroy-tree mock))))))}

  test {:doc "run script/bench.clj's unit tests"
        :task (p/shell "bb" "test/bench_test.clj")}

  bench {:doc "cold/warm boot-time comparison across memory tiers"
         :task (p/shell "bb" "script/bench_run.clj")}

  deploy {:doc "idempotent: publish the runtime layer, create/update the IAM role + Lambda function"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "deploy")}

  invoke {:doc "single ad-hoc invoke, prints response + REPORT line"
          :task (p/shell "bb" "script/aws_lifecycle.clj" "invoke")}

  teardown {:doc "delete the function, role, and every published layer version"
            :task (p/shell "bb" "script/aws_lifecycle.clj" "teardown")}

  demo {:doc "build + deploy + invoke in one go, checking every prerequisite before starting"
        :task (p/shell "bb" "script/demo.clj")}

  info {:doc "task cheat-sheet"
        :task (do (println "lambda-mvp-bb -- a shareable AWS Lambda custom runtime in Babashka via blambda")
                  (println "")
                  (println "  bb probe       offline e2e: mock Runtime API + blambda's real loop (no AWS, no Docker)")
                  (println "  bb demo        build + deploy + invoke in one go, prerequisites checked first")
                  (println "  bb build       bb blambda build-runtime-layer + build-lambda -> two zips in target/")
                  (println "  bb deploy      idempotent: publish runtime layer, create/update role + function")
                  (println "  bb invoke      single ad-hoc invoke, prints response + REPORT line")
                  (println "  bb bench       cold/warm boot-time comparison across memory tiers")
                  (println "  bb test        run script/bench.clj's unit tests")
                  (println "  bb teardown    delete the function, role, and every published layer version")
                  (println "  bb clean       remove build artifacts")
                  (println "  bb site:build  build the docs site into _site/ (needs a docs-engine checkout)")
                  (println "  bb site:serve  build the docs site and serve it locally")
                  (println "  bb site:clean  delete the _site/ build output")
                  (println "")
                  (println "No task hardcodes an AWS profile, account, or region -- see README.md"))}

  site:build {:doc "build the docs site into _site/ (needs a docs-engine checkout)"
              :task (site-task "build")}

  site:serve {:doc "build the docs site and serve it locally (bb site:serve [port], default 3000)"
              :task (site-task "serve" (first *command-line-args*))}

  site:clean {:doc "delete the _site/ build output"
              :task (site-task "clean")}}}
